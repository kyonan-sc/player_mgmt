# staging / production 用。実際の値は .env.staging.local 等（Git 管理外）または GitHub Actions の Variables に設定する。
# VITE_ で始まる値はビルド成果物に埋め込まれる公開情報として扱うこと。
VITE_APP_ENV=staging
VITE_USE_MOCK=false
VITE_API_URL=https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
VITE_GOOGLE_CLIENT_ID=<OAuth クライアント ID>.apps.googleusercontent.com
